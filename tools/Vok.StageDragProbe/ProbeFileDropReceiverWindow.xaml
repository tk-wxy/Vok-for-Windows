<Window x:Class="Vok.StageDragProbe.ProbeFileDropReceiverWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vok Stage Drag Receiver"
        Width="560" Height="340" MinWidth="360" MinHeight="240"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        AllowsTransparency="False" Topmost="False" ShowActivated="False"
        AllowDrop="True" PreviewDragEnter="OnDragEnter" PreviewDragOver="OnDragOver"
        PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop">
    <!-- Window owns the receiver routes; passive content keeps the template hit surface stable. -->
    <Border Padding="28" IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Stage 文件接收探针" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="PolicyText" FontSize="16" Margin="0,16,0,0" />
            <TextBlock x:Name="StatusText" Text="等待文件拖入" FontSize="16"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="记录路径顺序与结果；按 Esc 结束本次探针。"
                       TextWrapping="Wrap" Margin="0,20,0,0" />
        </StackPanel>
    </Border>
</Window>
