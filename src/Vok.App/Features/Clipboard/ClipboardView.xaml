<UserControl x:Class="Vok.Features.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:clipboard="clr-namespace:Vok.Features.Clipboard">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Border Padding="16,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="剪贴板"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 条}"
                     Margin="0,0,8,0"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     VerticalAlignment="Center" />
          <Button x:Name="ClearHistoryButton"
                  MinWidth="34"
                  Height="20"
                  Padding="6,0"
                  FontSize="10"
                  Content="{Binding ClearHistoryButtonText}"
                  Command="{Binding ClearHistoryCommand}"
                  ToolTip="清空全部 Vok 剪贴板历史；不改变系统剪贴板"
                  automation:AutomationProperties.Name="清空全部 Vok 剪贴板历史" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox x:Name="ClipboardItemsList"
             Grid.Row="1"
             Margin="8,6,8,6"
             Padding="0"
             ItemsSource="{Binding Items}"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             PreviewKeyDown="OnItemsPreviewKeyDown">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type clipboard:ClipboardItemViewModel}">
          <Border MinHeight="106"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  ClipToBounds="True">
            <Grid>
              <Button Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType={x:Type clipboard:ClipboardView}}}"
                      CommandParameter="{Binding}"
                      Padding="12,9,12,34"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      ToolTip="{Binding PasteToolTip}"
                      automation:AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                  <Grid x:Name="TextCardContent">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding PreviewText}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="72" />
                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Text="{Binding CapturedAtText}"
                               FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFileList}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsImage}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                  </Grid>

                  <Grid x:Name="ImageCardContent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="92"
                            Height="64"
                            Margin="0,0,8,0"
                            CornerRadius="5"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                      <Border.Background>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,12,12"
                                      ViewportUnits="Absolute">
                          <DrawingBrush.Drawing>
                            <DrawingGroup>
                              <GeometryDrawing Brush="{DynamicResource ControlFillColorSecondaryBrush}"
                                               Geometry="M0,0 H12 V12 H0 Z" />
                              <GeometryDrawing Brush="{DynamicResource ControlFillColorTertiaryBrush}"
                                               Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
                            </DrawingGroup>
                          </DrawingBrush.Drawing>
                        </DrawingBrush>
                      </Border.Background>
                      <Image x:Name="ThumbnailImage"
                             Width="92"
                             Height="64"
                             Source="{x:Null}"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             Loaded="OnThumbnailLoaded"
                             Unloaded="OnThumbnailUnloaded"
                             DataContextChanged="OnThumbnailDataContextChanged" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="图片"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding ImageDimensionsText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding ThumbnailStatusText}"
                                 FontSize="9.5"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding CapturedAtText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsImage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                  </Grid>

                  <Grid x:Name="FileCardContent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            Margin="0,1,6,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="5"
                            VerticalAlignment="Top">
                      <Image Width="32"
                             Height="32"
                             Source="{Binding Icon}"
                             Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding PreviewText}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,3,0,0"
                                 Text="{Binding FileDetailsText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Border Padding="5,1"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="3">
                          <TextBlock Text="{Binding IntentText}"
                                     FontSize="9.5" />
                        </Border>
                        <TextBlock Margin="6,1,0,0"
                                   Text="{Binding AvailabilityText}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding CapturedAtText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFileList}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                  </Grid>
                </Grid>
              </Button>

              <StackPanel Margin="0,0,6,5"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
                <Button Width="28"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Command="{Binding DataContext.CopyFileCommand, RelativeSource={RelativeSource AncestorType={x:Type clipboard:ClipboardView}}}"
                        CommandParameter="{Binding}"
                        ToolTip="复制文件列表，不移动源文件"
                        automation:AutomationProperties.Name="复制文件列表，不移动源文件">
                  <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource {x:Type Button}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFileList}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock Text="&#xE8C8;"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="12" />
                </Button>
                <Button Width="28"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType={x:Type clipboard:ClipboardView}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding PinToolTip}"
                        automation:AutomationProperties.Name="{Binding PinToolTip}">
                  <TextBlock Text="{Binding PinGlyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="12" />
                </Button>
                <Button Width="28"
                        Height="26"
                        Padding="0"
                        Click="OnRemoveClick"
                        ToolTip="{Binding DeleteToolTip}"
                        automation:AutomationProperties.Name="{Binding DeleteToolTip}">
                  <TextBlock Text="{Binding DeleteGlyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="12" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1"
               Margin="24"
               Text="{Binding EmptyStateText}"
               FontSize="12"
               LineHeight="20"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Border Grid.Row="2"
            Padding="10,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="10"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
