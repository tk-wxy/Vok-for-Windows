<UserControl x:Class="Vok.Features.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:clipboard="clr-namespace:Vok.Features.Clipboard">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Border Padding="16,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="剪贴板"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 条}"
                   FontSize="10.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ListBox x:Name="ClipboardItemsList"
             Grid.Row="1"
             Margin="8,6,8,6"
             Padding="0"
             ItemsSource="{Binding Items}"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             PreviewKeyDown="OnItemsPreviewKeyDown">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type clipboard:ClipboardItemViewModel}">
          <Border MinHeight="106"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  ClipToBounds="True">
            <Grid>
              <Button Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType={x:Type clipboard:ClipboardView}}}"
                      CommandParameter="{Binding}"
                      Padding="12,9,12,34"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      ToolTip="粘贴到呼出前目标"
                      automation:AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding PreviewText}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             MaxHeight="72" />
                  <TextBlock Grid.Row="1"
                             Margin="0,6,0,0"
                             Text="{Binding CapturedAtText}"
                             FontSize="10"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
              </Button>

              <StackPanel Margin="0,0,6,5"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
                <Button Width="28"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType={x:Type clipboard:ClipboardView}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding PinToolTip}"
                        automation:AutomationProperties.Name="{Binding PinToolTip}">
                  <TextBlock Text="{Binding PinGlyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="12" />
                </Button>
                <Button Width="28"
                        Height="26"
                        Padding="0"
                        Click="OnRemoveClick"
                        ToolTip="{Binding DeleteToolTip}"
                        automation:AutomationProperties.Name="{Binding DeleteToolTip}">
                  <TextBlock Text="{Binding DeleteGlyph}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="12" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1"
               Margin="24"
               Text="复制文本后会自动显示在这里。&#x0a;当前阶段支持纯文本、HTML 和 RTF。"
               FontSize="12"
               LineHeight="20"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Border Grid.Row="2"
            Padding="10,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="10"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
