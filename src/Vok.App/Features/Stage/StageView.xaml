<UserControl x:Class="Vok.Features.Stage.StageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:stage="clr-namespace:Vok.Features.Stage"
             automation:AutomationProperties.Name="中转站">
  <UserControl.Resources>
    <Duration x:Key="StageHoverEnterDuration">0:0:0.12</Duration>
    <Duration x:Key="StageHoverExitDuration">0:0:0.16</Duration>
    <sys:Double x:Key="StageHoverScale">1.02</sys:Double>
    <sys:Double x:Key="StageActionChromeRestOpacity">0.55</sys:Double>
    <sys:Double x:Key="StageDropWashOpacity">0.08</sys:Double>
    <Style x:Key="StagePageButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="StageItemActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <DataTemplate x:Key="StageCardContentTemplate"
                  DataType="{x:Type stage:StageItemViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border x:Name="StageItemPreviewSurface"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="9,9,0,0">
          <Border x:Name="StageItemIconSurface"
                  Width="40"
                  Height="40"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0.5"
                  CornerRadius="9">
            <TextBlock x:Name="StageItemGlyph"
                       Text="{Binding Glyph}"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="21"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground"
                          Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Foreground"
                              Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </Border>

        <Border x:Name="StageItemLabelSurface"
                Grid.Row="1"
                Padding="6,1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0.5,0,0"
                CornerRadius="0,0,9,9">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="15" />
              <RowDefinition Height="15" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StageItemName"
                       Text="{Binding DisplayName}"
                       FontSize="10"
                       FontWeight="Medium"
                       TextAlignment="Left"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="StageItemMetaText"
                       Grid.Row="1"
                       Text="{Binding CompactMetaText}"
                       FontSize="9"
                       TextAlignment="Left"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground"
                          Value="{DynamicResource TextFillColorTertiaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasAvailabilityStatus}" Value="True">
                      <Setter Property="Foreground"
                              Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Foreground"
                              Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="StageLayoutRoot"
        Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Grid x:Name="StageInteractionSurface"
          Grid.RowSpan="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <Border Padding="16,0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="中转站"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="6,1"
                  VerticalAlignment="Center"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 项}"
                       FontSize="9.5"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Border>
          <TextBlock Grid.Column="2"
                     Margin="12,0,0,0"
                     Text="{Binding StatusText}"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     ToolTip="{Binding StatusText}" />
        </Grid>
      </Border>

      <Grid x:Name="StageItemsViewport"
            Grid.Row="1"
            SizeChanged="OnStageItemsViewportSizeChanged">
        <ListBox x:Name="StageItemsList"
                 Margin="8,6,8,0"
                 Padding="0"
                 ItemsSource="{Binding CardRows, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="False"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 automation:AutomationProperties.Name="中转项目">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type stage:StageCardRowViewModel}">
              <ItemsControl Width="{Binding CardRowSurfaceWidth, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                            Height="{Binding CardRowUnitHeight, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                            HorizontalAlignment="Center"
                            ItemsSource="{Binding Items}">
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Panel.ZIndex" Value="0" />
                    <Style.Triggers>
                      <Trigger Property="stage:StageView.IsInteractionActive" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:UniformGrid Rows="1"
                                          Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type stage:StageItemViewModel}">
                    <Border x:Name="StageItemCard"
                            Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                            Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0.5"
                            CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True"
                            ToolTip="{Binding TargetValue}"
                            Loaded="OnStageItemCardLoaded"
                            Unloaded="OnStageItemCardUnloaded"
                            DataContextChanged="OnStageItemCardDataContextChanged"
                            MouseEnter="OnStageItemCardMouseStateChanged"
                            MouseLeave="OnStageItemCardMouseStateChanged"
                            IsKeyboardFocusWithinChanged="OnStageItemCardKeyboardFocusWithinChanged"
                            automation:AutomationProperties.Name="{Binding AutomationName}">
                      <Border.RenderTransform>
                        <ScaleTransform x:Name="StageItemCardScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                      </Border.RenderTransform>
                      <Grid ClipToBounds="True">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource StageCardContentTemplate}"
                                        Focusable="False" />

                        <Border x:Name="StageItemHoverOverlay"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="0.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"
                                Opacity="0" />

                        <Border x:Name="StageItemFocusRing"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"
                                Opacity="0" />

                        <Grid x:Name="StageItemActionChrome"
                              Opacity="{StaticResource StageActionChromeRestOpacity}">
                          <Button x:Name="StageItemPinButton"
                                  Margin="2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding CanManage}"
                                  Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                                  CommandParameter="{Binding}">
                            <Button.Style>
                              <Style TargetType="Button"
                                     BasedOn="{StaticResource StageItemActionButtonStyle}">
                                <Setter Property="ToolTip" Value="固定" />
                                <Setter Property="automation:AutomationProperties.Name" Value="固定中转项目" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="ToolTip" Value="取消固定" />
                                    <Setter Property="automation:AutomationProperties.Name" Value="取消固定中转项目" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE718;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="12" />
                          </Button>
                          <Button x:Name="StageItemMenuButton"
                                  Margin="2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource StageItemActionButtonStyle}"
                                  IsEnabled="{Binding CanManage}"
                                  ToolTip="更多管理操作"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type stage:StageView}}}"
                                  Click="OnStageItemMenuClick"
                                  automation:AutomationProperties.Name="打开中转站项目菜单">
                            <Button.Content>
                              <TextBlock Text="&#xE712;"
                                         FontFamily="Segoe Fluent Icons"
                                         FontSize="12" />
                            </Button.Content>
                            <Button.ContextMenu>
                              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                           Opened="OnStageItemContextMenuOpened"
                                           Closed="OnStageItemContextMenuClosed">
                                <MenuItem Header="打开"
                                          IsEnabled="{Binding CanOpenOrReveal}"
                                          Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="在文件资源管理器中定位"
                                          IsEnabled="{Binding CanOpenOrReveal}"
                                          Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="复制原路径"
                                          IsEnabled="{Binding CanManage}"
                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="重新关联…"
                                          IsEnabled="{Binding CanManage}"
                                          Command="{Binding PlacementTarget.Tag.RelinkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="从中转站移除"
                                          ToolTip="只移除引用，不删除原文件"
                                          Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                          </Button>
                        </Grid>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="StageItemCard"
                               Property="stage:StageView.IsInteractionActive"
                               Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="StageItemHoverOverlay"
                                               Storyboard.TargetProperty="Opacity"
                                               To="1"
                                               Duration="{StaticResource StageHoverEnterDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemCardScale"
                                               Storyboard.TargetProperty="ScaleX"
                                               To="{StaticResource StageHoverScale}"
                                               Duration="{StaticResource StageHoverEnterDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemCardScale"
                                               Storyboard.TargetProperty="ScaleY"
                                               To="{StaticResource StageHoverScale}"
                                               Duration="{StaticResource StageHoverEnterDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemActionChrome"
                                               Storyboard.TargetProperty="Opacity"
                                               To="1"
                                               Duration="{StaticResource StageHoverEnterDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="StageItemHoverOverlay"
                                               Storyboard.TargetProperty="Opacity"
                                               To="0"
                                               Duration="{StaticResource StageHoverExitDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemCardScale"
                                               Storyboard.TargetProperty="ScaleX"
                                               To="1"
                                               Duration="{StaticResource StageHoverExitDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemCardScale"
                                               Storyboard.TargetProperty="ScaleY"
                                               To="1"
                                               Duration="{StaticResource StageHoverExitDuration}" />
                              <DoubleAnimation Storyboard.TargetName="StageItemActionChrome"
                                               Storyboard.TargetProperty="Opacity"
                                               To="{StaticResource StageActionChromeRestOpacity}"
                                               Duration="{StaticResource StageHoverExitDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                      <Trigger SourceName="StageItemCard"
                               Property="stage:StageView.IsKeyboardContextActive"
                               Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="StageItemFocusRing"
                                               Storyboard.TargetProperty="Opacity"
                                               To="1"
                                               Duration="{StaticResource StageHoverEnterDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="StageItemFocusRing"
                                               Storyboard.TargetProperty="Opacity"
                                               To="0"
                                               Duration="{StaticResource StageHoverExitDuration}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid IsHitTestVisible="False">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock Text="&#xE8B7;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="28"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Margin="0,10,0,0"
                       Text="将文件、文件夹或快捷方式拖到这里"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid IsHitTestVisible="False">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowErrorState}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <TextBlock Margin="24"
                     Text="{Binding StatusText}"
                     FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>

        <ProgressBar Height="2"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     IsHitTestVisible="False">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar"
                   BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </Grid>

      <Border Grid.Row="2"
              Padding="8,2"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Button Style="{StaticResource StagePageButtonStyle}"
                  HorizontalAlignment="Left"
                  Content="较新"
                  Command="{Binding LoadNewerCommand}"
                  automation:AutomationProperties.Name="显示较新的中转项目" />
          <TextBlock Text="{Binding PageSummaryText}"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <Button Style="{StaticResource StagePageButtonStyle}"
                  HorizontalAlignment="Right"
                  Content="较早"
                  Command="{Binding LoadOlderCommand}"
                  automation:AutomationProperties.Name="显示较早的中转项目" />
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="DropOverlay"
          Grid.RowSpan="3"
          Panel.ZIndex="20"
          IsHitTestVisible="False"
          Visibility="Collapsed"
          automation:AutomationProperties.Name="松开以存入中转站">
      <Grid.RowDefinitions>
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <Border x:Name="StageDropWash"
              Grid.RowSpan="3"
              Background="{DynamicResource AccentFillColorDefaultBrush}"
              Opacity="{StaticResource StageDropWashOpacity}" />

      <Border x:Name="StageDropOutline"
              Grid.RowSpan="3"
              BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
              BorderThickness="2"
              CornerRadius="0"
              SnapsToDevicePixels="True" />

      <Border x:Name="StageDropPrompt"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,12,0,0"
              Padding="12,6"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="14">
        <TextBlock x:Name="StageDropPromptText"
                   Text="松开以存入中转站"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
