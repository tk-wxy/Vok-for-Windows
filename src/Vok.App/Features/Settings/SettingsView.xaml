<UserControl x:Class="Vok.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="clr-namespace:Vok.Core.Appearance;assembly=Vok.Core"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             IsVisibleChanged="OnIsVisibleChanged"
             automation:AutomationProperties.Name="设置窗口">
  <UserControl.Resources>
    <Style x:Key="SettingsIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsNavigationItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="ItemSurface"
                      Padding="13,10"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="9">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center" />
              </Border>
              <Border x:Name="SelectionIndicator"
                      Width="3"
                      Height="18"
                      Margin="3,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AccentFillColorDefaultBrush}"
                      CornerRadius="2"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="Background"
                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="ItemSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter TargetName="SelectionIndicator"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ItemSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="SettingsActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="SettingsMask"
        Background="#59000000"
        MouseLeftButtonDown="OnMaskMouseLeftButtonDown">
    <Border x:Name="SettingsWindow"
            MaxWidth="760"
            MaxHeight="560"
            Margin="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="OnSettingsWindowMouseLeftButtonDown"
            automation:AutomationProperties.Name="设置">
      <Border.Effect>
        <DropShadowEffect Color="#000000"
                          BlurRadius="36"
                          ShadowDepth="10"
                          Opacity="0.42" />
      </Border.Effect>

      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="62" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
              <TextBlock Text="&#xE713;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="16"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Margin="10,0,0,0"
                         Text="设置"
                         FontSize="15"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="SettingsCloseButton"
                    Style="{StaticResource SettingsIconButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseSettingsCommand}"
                    ToolTip="关闭 (Esc)"
                    automation:AutomationProperties.Name="关闭设置">
              <TextBlock Text="&#xE711;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="14" />
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="164" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Padding="12,16"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
            <ListBox x:Name="SettingsNavigation"
                     SelectedIndex="0"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                     automation:AutomationProperties.Name="设置分类">
              <ListBoxItem automation:AutomationProperties.Name="常规设置">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="常规"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>

              <ListBoxItem automation:AutomationProperties.Name="快捷键设置">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE765;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="快捷键"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>

              <ListBoxItem automation:AutomationProperties.Name="关于 Vok">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="关于"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>
            </ListBox>
          </Border>

          <Grid Grid.Column="1">
            <ScrollViewer x:Name="GeneralPanel"
                          Padding="24,22,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="常规"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,20"
                           Text="调整 Vok 的外观与后台行为"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel>
                    <TextBlock Text="界面主题"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="选择与系统同步，或固定使用浅色、深色外观"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <WrapPanel Margin="0,15,0,0">
                    <RadioButton Content="跟随系统"
                                 Margin="0,0,18,6"
                                 Padding="2,3"
                                 IsChecked="{Binding Settings.IsSystemTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.System}" />
                    <RadioButton Content="浅色"
                                 Margin="0,0,18,6"
                                 Padding="2,3"
                                 IsChecked="{Binding Settings.IsLightTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.Light}" />
                    <RadioButton Content="深色"
                                 Margin="0,0,0,6"
                                 Padding="2,3"
                                 IsChecked="{Binding Settings.IsDarkTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.Dark}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="托盘与后台"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="隐藏工作台后，Vok 继续在通知区域运行"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Border>

                <TextBlock Margin="2,0,2,0"
                           Text="{Binding Settings.ThemeErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HotkeyPanel"
                          Padding="24,22,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="1">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="快捷键"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,20"
                           Text="设置用于显示或隐藏工作台的全局组合键"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel>
                    <TextBlock Text="呼出 / 隐藏"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="点击右侧后直接按下新的组合键"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="HotkeyRecorderButton"
                          Margin="0,16,0,0"
                          MinWidth="190"
                          HorizontalAlignment="Left"
                          Style="{StaticResource SettingsActionButtonStyle}"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Center"
                          Click="OnHotkeyRecorderClick"
                          PreviewKeyDown="OnHotkeyRecorderPreviewKeyDown"
                          LostKeyboardFocus="OnHotkeyRecorderLostKeyboardFocus"
                          automation:AutomationProperties.Name="录制呼出快捷键">
                    <TextBlock Text="{Binding Settings.HotkeyDisplayText}"
                               FontSize="13" />
                    </Button>
                  </StackPanel>
                </Border>

                <Border Padding="16,13"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10">
                  <StackPanel>
                    <TextBlock Text="短按切换显隐；长按时保持显示，松开后隐藏。"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               Text="录制时按 Esc 可取消，原快捷键会自动恢复。"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
                <TextBlock Margin="2,10,2,0"
                           Text="{Binding Settings.HotkeyErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel"
                          Padding="24,22,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="2">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="关于"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,20"
                           Text="Vok 应用信息"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56"
                            Height="56"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="16"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                      <TextBlock Text="V"
                                 Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                 FontSize="26"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,1">
                      <TextBlock Text="Vok"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding ApplicationVersionText}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Margin="0,10,0,0"
                                 Text="面向 Windows 的全屏桌面工作台"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
