<UserControl x:Class="Vok.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="clr-namespace:Vok.Core.Appearance;assembly=Vok.Core"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             IsVisibleChanged="OnIsVisibleChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="42,30,42,42"
          MaxWidth="840"
          HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Padding="22"
              CornerRadius="12"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="选择 Vok 的界面主题"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding Settings.ThemeErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Margin="28,0,0,0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <RadioButton Content="跟随系统"
                         Margin="0,0,16,0"
                         IsChecked="{Binding Settings.IsSystemTheme, Mode=OneWay}"
                         Command="{Binding Settings.ChangeThemeCommand}"
                         CommandParameter="{x:Static appearance:AppThemeMode.System}" />
            <RadioButton Content="浅色"
                         Margin="0,0,16,0"
                         IsChecked="{Binding Settings.IsLightTheme, Mode=OneWay}"
                         Command="{Binding Settings.ChangeThemeCommand}"
                         CommandParameter="{x:Static appearance:AppThemeMode.Light}" />
            <RadioButton Content="深色"
                         IsChecked="{Binding Settings.IsDarkTheme, Mode=OneWay}"
                         Command="{Binding Settings.ChangeThemeCommand}"
                         CommandParameter="{x:Static appearance:AppThemeMode.Dark}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Margin="0,14,0,0"
              Padding="22"
              CornerRadius="12"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="呼出快捷键" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="用于显示或隐藏工作台"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,5,0,0"
                       Text="点击右侧后录制新的组合键；Esc 取消"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding Settings.HotkeyErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <Button x:Name="HotkeyRecorderButton"
                  Grid.Column="1"
                  Margin="24,0,0,0"
                  MinWidth="190"
                  Padding="14,8"
                  HorizontalContentAlignment="Center"
                  VerticalAlignment="Center"
                  Click="OnHotkeyRecorderClick"
                  PreviewKeyDown="OnHotkeyRecorderPreviewKeyDown"
                  LostKeyboardFocus="OnHotkeyRecorderLostKeyboardFocus"
                  automation:AutomationProperties.Name="录制呼出快捷键">
            <TextBlock Text="{Binding Settings.HotkeyDisplayText}"
                       FontSize="13" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Margin="0,14,0,0"
              Padding="22"
              CornerRadius="12"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <TextBlock Text="托盘与后台" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Margin="0,7,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="隐藏工作台后，Vok 继续在通知区域运行。" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3"
              Margin="0,14,0,0"
              Padding="22"
              CornerRadius="12"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1"
                     Margin="24,0,0,0"
                     Text="{Binding ApplicationVersionText}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
