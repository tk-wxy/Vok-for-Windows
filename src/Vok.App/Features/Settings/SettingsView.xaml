<UserControl x:Class="Vok.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="clr-namespace:Vok.Core.Appearance;assembly=Vok.Core"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             IsVisibleChanged="OnIsVisibleChanged"
             automation:AutomationProperties.Name="设置窗口">
  <Grid x:Name="SettingsMask"
        Background="#59000000"
        MouseLeftButtonDown="OnMaskMouseLeftButtonDown">
    <Border x:Name="SettingsWindow"
            Width="720"
            Height="540"
            MaxWidth="720"
            MaxHeight="540"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="OnSettingsWindowMouseLeftButtonDown"
            automation:AutomationProperties.Name="设置">
      <Border.Effect>
        <DropShadowEffect Color="#000000"
                          BlurRadius="36"
                          ShadowDepth="10"
                          Opacity="0.42" />
      </Border.Effect>

      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="58" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="22,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
              <TextBlock Text="&#xE713;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="16"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Margin="10,0,0,0"
                         Text="设置"
                         FontSize="15"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="SettingsCloseButton"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseSettingsCommand}"
                    ToolTip="关闭 (Esc)"
                    automation:AutomationProperties.Name="关闭设置">
              <TextBlock Text="&#xE711;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="14" />
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Padding="12,14"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
            <ListBox x:Name="SettingsNavigation"
                     SelectedIndex="0"
                     Background="Transparent"
                     BorderThickness="0"
                     automation:AutomationProperties.Name="设置分类">
              <ListBoxItem Padding="10,9"
                           automation:AutomationProperties.Name="常规设置">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="常规"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>

              <ListBoxItem Margin="0,3,0,0"
                           Padding="10,9"
                           automation:AutomationProperties.Name="快捷键设置">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE765;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="快捷键"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>

              <ListBoxItem Margin="0,3,0,0"
                           Padding="10,9"
                           automation:AutomationProperties.Name="关于 Vok">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               Text="关于"
                               FontSize="13"
                               VerticalAlignment="Center" />
                  </StackPanel>
              </ListBoxItem>
            </ListBox>
          </Border>

          <Grid Grid.Column="1">
            <ScrollViewer x:Name="GeneralPanel"
                          Padding="28,22,28,28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="常规"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,18"
                           Text="调整 Vok 的外观与后台行为"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid MinHeight="64">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="界面主题"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              Margin="24,0,0,0"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <RadioButton Content="跟随系统"
                                 Margin="0,0,14,0"
                                 IsChecked="{Binding Settings.IsSystemTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.System}" />
                    <RadioButton Content="浅色"
                                 Margin="0,0,14,0"
                                 IsChecked="{Binding Settings.IsLightTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.Light}" />
                    <RadioButton Content="深色"
                                 IsChecked="{Binding Settings.IsDarkTheme, Mode=OneWay}"
                                 Command="{Binding Settings.ChangeThemeCommand}"
                                 CommandParameter="{x:Static appearance:AppThemeMode.Dark}" />
                  </StackPanel>
                </Grid>

                <Border Margin="0,8"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                <Grid MinHeight="64">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="托盘与后台"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="隐藏工作台后，Vok 继续在通知区域运行"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Grid>

                <TextBlock Margin="0,10,0,0"
                           Text="{Binding Settings.ThemeErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HotkeyPanel"
                          Padding="28,22,28,28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="1">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="快捷键"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,18"
                           Text="设置用于显示或隐藏工作台的全局组合键"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid MinHeight="72">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="呼出 / 隐藏"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="点击右侧后直接按下新的组合键"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <Button x:Name="HotkeyRecorderButton"
                          Grid.Column="1"
                          Margin="24,0,0,0"
                          MinWidth="180"
                          Padding="14,8"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Center"
                          Click="OnHotkeyRecorderClick"
                          PreviewKeyDown="OnHotkeyRecorderPreviewKeyDown"
                          LostKeyboardFocus="OnHotkeyRecorderLostKeyboardFocus"
                          automation:AutomationProperties.Name="录制呼出快捷键">
                    <TextBlock Text="{Binding Settings.HotkeyDisplayText}"
                               FontSize="13" />
                  </Button>
                </Grid>

                <TextBlock Margin="0,10,0,0"
                           Text="短按切换显隐；长按时保持显示，松开后隐藏。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="录制时按 Esc 可取消，原快捷键会自动恢复。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding Settings.HotkeyErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel"
                          Padding="28,22,28,28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNavigation}" Value="2">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Text="关于"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,24"
                           Text="Vok 应用信息"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        CornerRadius="15"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <TextBlock Text="V"
                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                             FontSize="26"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Margin="0,15,0,0"
                           Text="Vok"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="{Binding ApplicationVersionText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Text="面向 Windows 的全屏桌面工作台"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
