<UserControl x:Class="Vok.Features.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:launcher="clr-namespace:Vok.Features.Launcher"
             UseLayoutRounding="False"
             SnapsToDevicePixels="True"
             automation:AutomationProperties.Name="启动台静态区域">
  <UserControl.Resources>
    <Style x:Key="LauncherTileStyle" TargetType="ContentControl">
      <Setter Property="Height"
              Value="{Binding CardSurfaceHeight, RelativeSource={RelativeSource AncestorType={x:Type launcher:LauncherView}}}" />
      <Setter Property="Margin" Value="5,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border x:Name="CardSurface"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="10"
                    RenderTransformOrigin="0.5,0.5"
                    SnapsToDevicePixels="True">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
              </Border.RenderTransform>
              <Grid>
                <Border x:Name="HoverOverlay"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Opacity="0" />
                <ContentPresenter Margin="4,5,4,4"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="1" />
                <Trigger.EnterActions>
                  <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="CardScale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1.025"
                                       Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="CardScale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1.025"
                                       Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.16" />
                      <DoubleAnimation Storyboard.TargetName="CardScale"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="CardScale"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LauncherItemNameStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="1,5,1,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LineHeight" Value="13.5" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="MaxHeight" Value="27" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="16,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="启动台" FontSize="12" FontWeight="SemiBold" />
          <Border Margin="8,0,0,0"
                  MinWidth="22"
                  Padding="6,2"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  CornerRadius="9">
            <TextBlock Text="8"
                       FontSize="10"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="LauncherItemsViewport" Grid.Row="1" Margin="8,6,8,8">
      <ScrollViewer x:Name="LauncherScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden"
                    CanContentScroll="False"
                    Focusable="False"
                    PanningMode="VerticalOnly">
        <UniformGrid x:Name="LauncherPlaceholderGrid"
                     Columns="4"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top"
                     ClipToBounds="False"
                     automation:AutomationProperties.Name="启动台占位应用">
          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="文件资源管理器"
                          automation:AutomationProperties.Name="文件资源管理器">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#2563EB" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="文件资源管理器" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="记事本"
                          automation:AutomationProperties.Name="记事本">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#0F766E" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="记事本" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="计算器"
                          automation:AutomationProperties.Name="计算器">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#7C3AED" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="计算器" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="Windows 设置"
                          automation:AutomationProperties.Name="Windows 设置">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#475569" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="Windows 设置" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="终端"
                          automation:AutomationProperties.Name="终端">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#111827" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="终端" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="画图"
                          automation:AutomationProperties.Name="画图">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#DB2777" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="画图" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="任务管理器"
                          automation:AutomationProperties.Name="任务管理器">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#EA580C" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="任务管理器" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>

          <ContentControl Style="{StaticResource LauncherTileStyle}"
                          ToolTip="控制面板"
                          automation:AutomationProperties.Name="控制面板">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="46" Height="46" Background="#0891B2" CornerRadius="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" FontSize="23"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Row="1" Text="控制面板" Style="{StaticResource LauncherItemNameStyle}" />
            </Grid>
          </ContentControl>
        </UniformGrid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
