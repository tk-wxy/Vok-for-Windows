<UserControl x:Class="Vok.Features.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="启动台静态区域">
  <UserControl.Resources>
    <Style x:Key="LauncherTileStyle" TargetType="Border">
      <Setter Property="Height" Value="96" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="4,8,4,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="16,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Text="启动台"
                     FontSize="12"
                     FontWeight="SemiBold" />
          <Border Margin="8,0,0,0"
                  MinWidth="22"
                  Padding="6,2"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  CornerRadius="9">
            <TextBlock Text="8"
                       FontSize="10"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="8,6,8,8"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <UniformGrid x:Name="LauncherPlaceholderGrid"
                   Columns="4"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   automation:AutomationProperties.Name="启动台占位应用">
        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#2563EB" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="文件资源管理器" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#0F766E" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="记事本" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#7C3AED" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="计算器" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#475569" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="Windows 设置" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#111827" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="终端" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#DB2777" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="画图" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#EA580C" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="任务管理器" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource LauncherTileStyle}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#0891B2" CornerRadius="10"
                    HorizontalAlignment="Center">
              <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" FontSize="23"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="1,5,1,0" Text="控制面板" FontSize="10.5"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="28" LineHeight="14" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>
  </Grid>
</UserControl>
