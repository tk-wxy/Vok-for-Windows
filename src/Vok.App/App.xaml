<Application x:Class="Vok.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF151821" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA9B0C2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF86A7FF" />
  </Application.Resources>
</Application>
