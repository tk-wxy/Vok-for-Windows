<Window x:Class="Vok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:settings="clr-namespace:Vok.Features.Settings"
        Title="Vok"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid x:Name="WorkspaceInputAnchor"
        Focusable="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        automation:AutomationProperties.Name="Vok 工作台">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border Width="34"
                  Height="34"
                  CornerRadius="9"
                  Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock Text="V"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       FontSize="17"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="12,0,0,0"
                     Text="Vok"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Width="38"
                  Height="38"
                  Command="{Binding CloseSettingsCommand}"
                  ToolTip="返回工作台"
                  automation:AutomationProperties.Name="返回工作台">
            <TextBlock Text="&#xE72B;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15" />
          </Button>
          <TextBlock Margin="12,0,0,0"
                     Text="设置"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Width="38"
                Height="38"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding OpenSettingsCommand}"
                ToolTip="设置"
                automation:AutomationProperties.Name="设置">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock Text="&#xE713;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="16" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64"
                Height="64"
                CornerRadius="18"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
          <TextBlock Text="V"
                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                     FontSize="30"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Margin="0,18,0,0"
                   Text="Vok"
                   FontSize="28"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <settings:SettingsView Grid.Row="1">
      <settings:SettingsView.Style>
        <Style TargetType="settings:SettingsView">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </settings:SettingsView.Style>
    </settings:SettingsView>
  </Grid>
</Window>
