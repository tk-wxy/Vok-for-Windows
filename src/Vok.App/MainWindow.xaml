<Window x:Class="Vok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:settings="clr-namespace:Vok.Features.Settings"
        Title="Vok"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid x:Name="WorkspaceInputAnchor"
        Focusable="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        automation:AutomationProperties.Name="Vok 工作台">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34"
                  Height="34"
                  CornerRadius="9"
                  Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock Text="V"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       FontSize="17"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="12,0,0,0"
                     Text="Vok"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Grid HorizontalAlignment="Right"
              VerticalAlignment="Center">
          <Button x:Name="OpenSettingsButton"
                  Height="38"
                  MinWidth="88"
                  Padding="13,0"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip="打开设置"
                  automation:AutomationProperties.Name="打开设置">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0"
                         Text="设置"
                         FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64"
                Height="64"
                CornerRadius="18"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
          <TextBlock Text="V"
                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                     FontSize="30"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Margin="0,18,0,0"
                   Text="Vok"
                   FontSize="28"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <settings:SettingsView x:Name="SettingsOverlay"
                           Grid.RowSpan="2"
                           Panel.ZIndex="10">
      <settings:SettingsView.Style>
        <Style TargetType="settings:SettingsView">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </settings:SettingsView.Style>
    </settings:SettingsView>
  </Grid>
</Window>
