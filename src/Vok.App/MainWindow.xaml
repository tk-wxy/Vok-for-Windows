<Window x:Class="Vok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:launcher="clr-namespace:Vok.Features.Launcher"
        xmlns:clipboard="clr-namespace:Vok.Features.Clipboard"
        xmlns:stage="clr-namespace:Vok.Features.Stage"
        xmlns:settings="clr-namespace:Vok.Features.Settings"
        Title="Vok"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AllowDrop="True"
        Closing="OnClosing"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="HeaderIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="WorkspaceInputAnchor"
        Focusable="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        automation:AutomationProperties.Name="Vok 工作台">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <!-- Workbench 式顶栏：品牌、居中搜索预留、设置。 -->
    <Border Padding="24,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Width="30"
                  Height="30"
                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                  CornerRadius="7">
            <TextBlock Text="V"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="10,0,0,0"
                     Text="Vok"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 仅预留视觉位置，不创建搜索输入与搜索行为。 -->
        <Border x:Name="HeaderSearchPlaceholder"
                Grid.Column="1"
                Height="36"
                MaxWidth="480"
                Margin="24,0"
                Padding="13,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                automation:AutomationProperties.Name="搜索框预留区域">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Margin="9,0,0,0"
                       Text="搜索应用、中转、剪贴板…"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button x:Name="OpenSettingsButton"
                Grid.Column="2"
                Style="{StaticResource HeaderIconButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding OpenSettingsCommand}"
                ToolTip="打开设置"
                automation:AutomationProperties.Name="打开设置">
          <TextBlock Text="&#xE713;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="16" />
        </Button>
      </Grid>
    </Border>

    <!-- 主体严格 1:2:1：启动台 / 中转站 / 剪贴板。 -->
    <Grid x:Name="MainWorkspaceGrid"
          Grid.Row="1"
          Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <launcher:LauncherView x:Name="LauncherPanel" />
      </Border>

      <Border x:Name="StageRegion"
              Grid.Column="1"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0"
              automation:AutomationProperties.Name="中转站区域">
        <stage:StageView x:Name="StagePanel"
                         CardHeight="{Binding CardSurfaceHeight, ElementName=LauncherPanel}"
                         CardRowUnitHeight="{Binding CardUnitHeight, ElementName=LauncherPanel}" />
      </Border>

      <Border x:Name="ClipboardRegion"
              Grid.Column="2"
              automation:AutomationProperties.Name="剪贴板历史区域">
        <clipboard:ClipboardView x:Name="ClipboardPanel" />
      </Border>
    </Grid>

    <!-- Workbench 式底部单行条，仅承载现有真实信息。 -->
    <Border x:Name="BottomBar"
            Grid.Row="2"
            Padding="24,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            automation:AutomationProperties.Name="底部状态栏">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Ellipse Width="6"
                   Height="6"
                   Fill="{DynamicResource AccentFillColorDefaultBrush}" />
          <TextBlock Margin="8,0,0,0"
                     Text="Vok 工作台"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding Settings.HotkeyDisplayText}"
                     FontSize="10.5"
                     FontWeight="SemiBold" />
          <TextBlock Margin="6,0,0,0"
                     Text="切换"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="14,0"
                     Text="·"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="Esc"
                     FontSize="10.5"
                     FontWeight="SemiBold" />
          <TextBlock Margin="6,0,0,0"
                     Text="关闭"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   Text="{Binding ApplicationVersionText}"
                   FontSize="10.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <settings:SettingsView x:Name="SettingsOverlay"
                           Grid.RowSpan="3"
                           Panel.ZIndex="30">
      <settings:SettingsView.Style>
        <Style TargetType="settings:SettingsView">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </settings:SettingsView.Style>
    </settings:SettingsView>
  </Grid>
</Window>
